<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.ItemMasterController"
            style="-fx-background-color:#f3f6f8;">

    <!-- ===== HEADER + FORM ===== -->
    <top>
        <VBox spacing="14"
              style="-fx-padding:14 16 10 16;">

            <Label text="Item Master"
                   style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#263238;"/>

            <!-- ===== FORM CARD ===== -->
            <VBox spacing="12"
                  style="
                      -fx-background-color:white;
                      -fx-background-radius:12;
                      -fx-padding:14 16;
                      -fx-border-color:#e5e7eb;
                      -fx-border-radius:12;
                  ">

                <GridPane hgap="14" vgap="12">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="40"/>
                        <ColumnConstraints percentWidth="30"/>
                        <ColumnConstraints percentWidth="30"/>
                    </columnConstraints>

                    <!-- ROW 0 : Identity -->
                    <TextField fx:id="name"
                               promptText="Item Name"
                               style="
               -fx-font-size:14;
               -fx-pref-height:38;
           "/>

                    <TextField fx:id="hsn"
                               promptText="HSN Code"
                               GridPane.columnIndex="1"
                               style="
               -fx-font-size:14;
               -fx-pref-height:38;
           "/>

                    <ComboBox fx:id="unitCombo"
                              promptText="Unit"
                              GridPane.columnIndex="2"
                              style="
              -fx-font-size:14;
              -fx-pref-height:38;
          "/>

                    <TextField fx:id="rate"
                               promptText="Rate"
                               GridPane.rowIndex="1"
                               style="
               -fx-font-size:14;
               -fx-pref-height:38;
           "/>

                    <ComboBox fx:id="gstCombo"
                              promptText="GST %"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"
                              style="
              -fx-font-size:14;
              -fx-pref-height:38;
          "/>


                </GridPane>

                <!-- ===== ACTION ROW ===== -->
                <HBox alignment="CENTER_RIGHT">
                    <Button text="Save Item"
                            onAction="#save"
                            style="
            -fx-background-color:#1565c0;
            -fx-text-fill:white;
            -fx-font-size:14;
            -fx-font-weight:bold;
            -fx-background-radius:8;
            -fx-padding:10 22;
        "/>

                </HBox>

            </VBox>
        </VBox>
    </top>

    <!-- ===== TABLE ===== -->
    <center>
        <VBox style="-fx-padding:0 16 16 16;"
              VBox.vgrow="ALWAYS">

            <TableView fx:id="table"
                       VBox.vgrow="ALWAYS"
                       fixedCellSize="36"
                       style="
               -fx-background-color:white;
               -fx-background-radius:12;
               -fx-border-color:#e5e7eb;
               -fx-border-radius:12;
               -fx-font-size:13.5;
           ">


            <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="220"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="hsnCol" text="HSN" prefWidth="120"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="unitCol" text="Unit" prefWidth="80"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="rateCol" text="Rate" prefWidth="100"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="gstCol" text="GST %" prefWidth="80"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="activeCol" text="Active" prefWidth="70"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                </columns>

            </TableView>
        </VBox>
    </center>

</BorderPane>
