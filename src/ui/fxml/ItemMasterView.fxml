<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.ItemMasterController">

    <!-- ===== HEADER + FORM (COMPACT) ===== -->
    <top>
        <VBox spacing="10"
              style="-fx-padding:12;">

            <Label text="Item Master"
                   style="-fx-font-size:18; -fx-font-weight:bold;"/>

            <GridPane hgap="12" vgap="10">

                <columnConstraints>
                    <ColumnConstraints percentWidth="40"/>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="30"/>
                </columnConstraints>

                <!-- ROW 0 -->
                <TextField fx:id="name" promptText="Item Name"/>
                <TextField fx:id="hsn" promptText="HSN Code" GridPane.columnIndex="1"/>
                <ComboBox fx:id="unitCombo" promptText="Unit" GridPane.columnIndex="2"/>

                <!-- ROW 1 -->
                <TextField fx:id="rate" promptText="Rate" GridPane.rowIndex="1"/>
                <ComboBox fx:id="gstCombo" promptText="GST %" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Button text="Save Item"
                        onAction="#save"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="2"
                        GridPane.halignment="RIGHT"/>
            </GridPane>
        </VBox>
    </top>

    <!-- ===== TABLE (FULL HEIGHT) ===== -->
    <center>
        <TableView fx:id="table"
                   VBox.vgrow="ALWAYS"
                   style="-fx-padding:0;">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="220"/>
                <TableColumn fx:id="hsnCol" text="HSN" prefWidth="120"/>
                <TableColumn fx:id="unitCol" text="Unit" prefWidth="80"/>
                <TableColumn fx:id="rateCol" text="Rate" prefWidth="100"/>
                <TableColumn fx:id="gstCol" text="GST %" prefWidth="80"/>
                <TableColumn fx:id="activeCol" text="Active" prefWidth="70"/>
            </columns>
        </TableView>
    </center>

</BorderPane>

