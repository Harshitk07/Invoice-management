<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ui.CustomerMasterController"
        style="-fx-background-color:#f3f6f8;">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              style="-fx-padding:14 16 10 16;">

            <Label text="Customer Master"
                   style="
                       -fx-font-size:18;
                       -fx-font-weight:bold;
                       -fx-text-fill:#263238;
                   "/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="+ Add Customer"
                    onAction="#openAddCustomerDialog"
                    style="
                        -fx-background-color:#1565c0;
                        -fx-text-fill:white;
                        -fx-font-size:14;
                        -fx-font-weight:bold;
                        -fx-background-radius:8;
                        -fx-padding:10 18;
                    "/>
        </HBox>
    </top>

    <!-- ===== TABLE CARD ===== -->
    <center>
        <VBox VBox.vgrow="ALWAYS"
              style="-fx-padding:0 16 16 16;">

            <TableView fx:id="table"
                       VBox.vgrow="ALWAYS"
                       style="
                           -fx-background-color:white;
                           -fx-background-radius:12;
                           -fx-border-color:#e5e7eb;
                           -fx-border-radius:12;
                           -fx-font-size:13.5;
                       ">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="nameCol"
                                 text="Name"
                                 prefWidth="260"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="addressCol"
                                 text="Address"
                                 prefWidth="280"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="stateCol"
                                 text="State"
                                 prefWidth="140"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="gstCol"
                                 text="GST"
                                 prefWidth="140"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="activeCol"
                                 text="Active"
                                 prefWidth="70"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>

                    <TableColumn fx:id="editCol"
                                 text="Edit"
                                 prefWidth="80"
                                 style="-fx-font-size:13.5; -fx-font-weight:bold;"/>
                </columns>

            </TableView>
        </VBox>
    </center>

</BorderPane>
