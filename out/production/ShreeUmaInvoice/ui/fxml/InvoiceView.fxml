<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<ScrollPane hbarPolicy="NEVER"
            fitToWidth="true"
            prefHeight="600"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.InvoiceController" fx:id="root" >

    <MenuBar>
        <Menu text="Invoice">
            <MenuItem text="Reprint Invoice"
                      onAction="#openReprintDialog"/>
        </Menu>
    </MenuBar>


    <!-- PAGE CONTAINER -->
    <VBox
          alignment="TOP_CENTER" spacing="10"
          style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

        <!-- ================= CENTERED INVOICE ================= -->
        <StackPane alignment="TOP_CENTER">

            <VBox prefWidth="794"
                  minWidth="794"
                  maxWidth="794"
                  spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-border-color: black;">


                <!-- ================= HEADER ================= -->
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="companyNameLabel"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label fx:id="companyDescriptionLabel"/>
                    <Label fx:id="companyGstLabel"/>
                    <Label fx:id="companyContactLabel"
                           style="-fx-font-size: 11px;"/>

                    <Label text="TAX INVOICE"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label text="(Computer Generated Invoice)"
                           style="-fx-font-size: 10px;"/>
                </VBox>

                <Separator/>

                <!-- ================= INVOICE META ================= -->
                <GridPane hgap="8" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="277"/>
                        <ColumnConstraints prefWidth="40"/>
                        <ColumnConstraints prefWidth="160"/>
                    </columnConstraints>

                    <Label text="Invoice No"/>
                    <TextField fx:id="invoiceNoField" editable="false" />

                    <Label text="Date" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="invoiceDatePicker" GridPane.columnIndex="3"/>
                </GridPane>


                <Separator/>

                <!-- ================= BUYER / CONSIGNEE ================= -->
                <HBox spacing="15">

                    <!-- BUYER -->
                    <VBox spacing="6">
                        <Label text="DETAILS OF BUYER / BILL TO"
                               style="-fx-font-weight: bold;"/>

                        <HBox spacing="5">
                            <ComboBox fx:id="customerBox"
                                      promptText="Select Customer"
                                      HBox.hgrow="ALWAYS"/>
                            <Button text="+" onAction="#addNewCustomer"/>
                            <Button text="Edit" onAction="#editCustomer"/>

                        </HBox>

                        <TextArea fx:id="buyerAddressArea" prefRowCount="3"/>
                        <TextField fx:id="buyerGstField" promptText="GSTIN"/>

                        <HBox spacing="6">
                            <TextField fx:id="buyerStateField" promptText="Place of Supply"/>
                            <TextField fx:id="buyerStateCodeField"
                                       promptText="Code"
                                       prefWidth="70"/>
                        </HBox>

                        <!--                    <GridPane hgap="6" vgap="6">-->
                        <!--                        <columnConstraints>-->
                        <!--                            <ColumnConstraints prefWidth="110"/>-->
                        <!--                            <ColumnConstraints prefWidth="120"/>-->
                        <!--                        </columnConstraints>-->

                        <!--                        <Label text="Place of Supply"/>-->
                        <!--                        <TextField fx:id="buyerStateField"/>-->

                        <!--                        <Label text="Place Code" GridPane.rowIndex="1"/>-->
                        <!--                        <TextField fx:id="buyerStateCodeField"-->
                        <!--                                   GridPane.rowIndex="1"-->
                        <!--                                   prefWidth="70"/>-->
                        <!--                    </GridPane>-->
                    </VBox>

                    <!-- CONSIGNEE -->
                    <VBox spacing="6">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="DETAILS OF CONSIGNEE / SHIP TO"
                                   style="-fx-font-weight: bold;"/>
                            <CheckBox fx:id="sameAsBuyerCheck" text="Same as Buyer" onAction="#onSameAsBuyerToggle"/>
                        </HBox>

                        <TextField fx:id="consigneeNameField" promptText="Name"/>
                        <TextArea fx:id="consigneeAddressArea" prefRowCount="3"/>
                        <TextField fx:id="consigneeGstField" promptText="GSTIN"/>

                        <HBox spacing="6">
                            <TextField fx:id="consigneeStateField" promptText="State"/>
                            <TextField fx:id="consigneeStateCodeField"
                                       promptText="Code"
                                       prefWidth="70"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- ================= PO / DC ================= -->
                <GridPane hgap="82" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="40"/>
                        <ColumnConstraints prefWidth="180"/>
                        <ColumnConstraints prefWidth="50"/>
                        <ColumnConstraints prefWidth="180"/>
                    </columnConstraints>

                    <Label text="P.O No" />
                    <TextField fx:id="poNoField" GridPane.columnIndex="1"/>

                    <Label text="P.O Date" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="poDatePicker" GridPane.columnIndex="3"/>

                    <Label text="D.C No" GridPane.rowIndex="1"/>
                    <TextField fx:id="dcNoField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="D.C Date" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="dcDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                </GridPane>


                <GridPane hgap="15" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="107"/>
                        <ColumnConstraints prefWidth="180"/>
                        <ColumnConstraints prefWidth="150"/>
                        <ColumnConstraints prefWidth="210"/>
                    </columnConstraints>

                    <Label text="Dispatch Through"/>
                    <TextField fx:id="dispatchThroughField" GridPane.columnIndex="1" />

                    <Label text="E-Way Bill No" GridPane.columnIndex="2">
                        <GridPane.margin>
                            <Insets left="67.0" /> </GridPane.margin>
                    </Label>
                    <TextField fx:id="ewayBillField" GridPane.columnIndex="3">
                        <GridPane.margin>
                            <Insets left="35.0" /> </GridPane.margin>
                    </TextField>
                </GridPane>


                <Separator/>

                <!-- ================= ITEM TABLE ================= -->
                <TableView fx:id="table" prefHeight="260" style="-fx-font-size: 11px;">
                    <columns>
                        <TableColumn text="SL" fx:id="slNo" prefWidth="35"/>
                        <TableColumn text="Item" fx:id="itemCol" prefWidth="230"/>
                        <TableColumn text="HSN" fx:id="hsnCol" prefWidth="90"/>
                        <TableColumn text="Qty" fx:id="qtyCol" prefWidth="70"/>
                        <TableColumn text="Unit" fx:id="unitCol" prefWidth="35"/>
                        <TableColumn text="Rate" fx:id="rateCol" prefWidth="100"/>
                        <TableColumn text="GST %" fx:id="gstCol" prefWidth="55"/>
                        <TableColumn text="Amount" fx:id="amountCol" prefWidth="110"/>
                        <TableColumn text="" fx:id="deleteCol" prefWidth="35"/>

                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button text="+ Row" onAction="#addItemRow"/>
                    <Button text="+ Item" onAction="#addNewItem"/>

                </HBox>

                <Separator/>

                <!-- ================= TOTALS ================= -->
                <HBox spacing="15">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Amount in Words:"/>
                        <Label fx:id="amountWordsLabel" wrapText="true"
                               style="-fx-font-style: italic;"/>
                        <Label text="Punjab National Bank"/>
                        <Label text="A/C: 4481002100003591 | IFSC: PUNB0448100"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>


                    <VBox alignment="TOP_RIGHT">
                        <GridPane hgap="10" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="140"/>
                                <ColumnConstraints prefWidth="120"/>
                            </columnConstraints>

                            <Label text="Taxable Subtotal"/>
                            <Label fx:id="taxableAmountLabel" GridPane.columnIndex="1"/>

                            <Label fx:id="cgstTextLabel" text="CGST @" GridPane.rowIndex="1"/>
                            <Label fx:id="cgstLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label fx:id="sgstTextLabel" text="SGST @" GridPane.rowIndex="2"/>
                            <Label fx:id="sgstLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label fx:id="igstTextLabel" text="IGST @" GridPane.rowIndex="3"/>
                            <Label fx:id="igstLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <Label text="Round Off" GridPane.rowIndex="4"/>
                            <Label fx:id="roundOffLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <Label text="Grand Total"
                                   style="-fx-font-weight: bold;"
                                   GridPane.rowIndex="5"/>
                            <Label fx:id="totalLabel"
                                   style="-fx-font-weight: bold;"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="5"/>
                        </GridPane>
                    </VBox>

                    <CheckBox fx:id="roundOffCheck"
                              text="Apply Round Off"
                              selected="true"/>

                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Round Off Value"/>
                        <TextField fx:id="roundOffField"
                                   prefWidth="80"
                                   promptText="Auto"
                                   disable="true"
                                   style="-fx-border-color: #3498db; -fx-border-width: 2px; -fx-border-radius: 3px;"/>
                    </HBox>


                </HBox>

                <Separator/>

                <!-- ================= DECLARATION ================= -->


                <Separator/>

                <!-- ================= SIGNATURE ================= -->
                <HBox spacing="20">
                    <VBox spacing="15">
                        <VBox spacing="4">
                            <Label text="Certified that the particulars given above are true and correct"/>
                            <Label text="Goods once supplied will not be taken back"/>
                            <Label text="Subject to Visakhapatnam jurisdiction"/>
                        </VBox>
                        <VBox alignment="BASELINE_RIGHT"><Label text="Receiver's Signature" style="-fx-font-weight: bold;"/></VBox>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <!--                <Region HBox.hgrow="ALWAYS"/>-->
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="TOP_RIGHT" spacing="55">
                        <Label text="For SHREE UMA ASSOCIATES"
                               style="-fx-font-weight: bold;" />
                        <Label text="Authorised Signatory" />
                    </VBox>
                </HBox>

            </VBox>


        </StackPane>

        <!-- ================= SAVE ================= -->
        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20;">
            <Button fx:id="previewButton"
                    text="PREVIEW"
                    onAction="#previewInvoice"/>


            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">


                <Button fx:id="saveButton"
                        text="SAVE INVOICE"
                        onAction="#saveInvoice"
                        style="-fx-base: #27ae60;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-padding: 10 30 10 30;"/>

                <Button fx:id="savePrintButton"
                        text="SAVE &amp; PRINT"
                        onAction="#saveAndPrint"
                        style="-fx-base: #2980b9;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-padding: 10 30 10 30;"/>
                <Button text="PRINT"
                        onAction="#printCurrentInvoice"
                        prefWidth="160"
                        style="-fx-base: #2980b9;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-padding: 10 30 10 30;"
                        disable="true"
                        fx:id="printBtn"/>

            </HBox>
        </VBox>


    </VBox>
</ScrollPane>
