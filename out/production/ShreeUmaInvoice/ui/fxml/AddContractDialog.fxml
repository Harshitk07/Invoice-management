<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.AddContractController"
      prefWidth="500"
      style="-fx-padding:20; -fx-background-color:white;">

    <Label text="Create Contract"
           style="-fx-font-size:18px; -fx-font-weight:bold;" />

    <GridPane hgap="10" vgap="12">

        <Label text="Contract No" GridPane.rowIndex="0"/>
        <TextField fx:id="contractNoField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Description" GridPane.rowIndex="1"/>
        <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Base Quantity" GridPane.rowIndex="2"/>
        <TextField fx:id="baseQtyField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Variation %" GridPane.rowIndex="3"/>
        <TextField fx:id="variationField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Max Quantity" GridPane.rowIndex="4"/>
        <TextField fx:id="maxQtyField"
                   editable="false"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

        <Label text="Base Value" GridPane.rowIndex="5"/>
        <TextField fx:id="baseValueField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Max Value" GridPane.rowIndex="6"/>
        <TextField fx:id="maxValueField"
                   editable="false"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="6"/>

        <Label text="Start Date" GridPane.rowIndex="7"/>
        <DatePicker fx:id="startDatePicker"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="7"/>

        <Label text="End Date" GridPane.rowIndex="8"/>
        <DatePicker fx:id="endDatePicker"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="8"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#onCancel"/>
        <Button text="Save" onAction="#onSave"
                style="-fx-background-color:#2563EB; -fx-text-fill:white;"/>
    </HBox>

</VBox>