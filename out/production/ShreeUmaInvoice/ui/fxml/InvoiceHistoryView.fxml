<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.InvoiceHistoryController">

    <top>
        <Label text="Invoice History"
               style="-fx-font-size:16px; -fx-padding:10"/>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn text="FY" fx:id="colFY"/>
                <TableColumn text="Invoice No" fx:id="colNo"/>
                <TableColumn text="Date" fx:id="colDate"/>
                <TableColumn text="Customer" fx:id="colBuyer"/>
                <TableColumn text="Amount" fx:id="colTotal"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-padding:10">
            <Button text="Preview / Print" onAction="#preview"/>
            <Button text="Close" onAction="#close"/>

        </HBox>
    </bottom>

</BorderPane>
