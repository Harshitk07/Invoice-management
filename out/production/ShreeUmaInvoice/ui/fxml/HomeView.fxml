<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root"
      spacing="26"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.HomeController"
      style="-fx-padding:30;">

    <!-- ================= SYSTEM STATUS ================= -->
    <VBox fx:id="systemStatusCard"
          spacing="14"
          style="
        -fx-background-color:white;
        -fx-padding:20;
        -fx-background-radius:16;
        -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0.3, 0, 4);
      ">

        <Label text="System Status"
               style="-fx-font-size:17; -fx-font-weight:bold; -fx-text-fill:#263238;"/>

        <HBox spacing="24">

            <VBox spacing="4">
                <Label text="Auto Backup"
                       style="-fx-font-size:12; -fx-text-fill:#607d8b;"/>
                <Label fx:id="backupStatusLabel"
                       style="-fx-font-size:14; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Database Size"
                       style="-fx-font-size:12; -fx-text-fill:#607d8b;"/>
                <Label fx:id="dbSizeLabel"
                       style="-fx-font-size:14; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Invoices"
                       style="-fx-font-size:12; -fx-text-fill:#607d8b;"/>
                <Label fx:id="invoiceCountLabel"
                       style="-fx-font-size:14; -fx-font-weight:bold;"/>
            </VBox>

        </HBox>
    </VBox>


    <!-- ================= CORE OPERATIONS ================= -->
    <VBox fx:id="coreOpsCard"
          spacing="14"
          style="
            -fx-background-color:white;
            -fx-padding:20;
            -fx-background-radius:16;
            -fx-effect:dropshadow(gaussian, rgba(21,101,192,0.18), 18, 0.3, 0, 6);
          ">

        <Label text="Core Operations"
               style="-fx-font-size:17; -fx-font-weight:bold; -fx-text-fill:#263238;"/>

        <FlowPane hgap="14" vgap="14">

            <Button text="+  New Invoice"
                    onAction="#newInvoice"
                    style="
          -fx-background-color:#1565c0;
          -fx-text-fill:white;
          -fx-font-size:14;
          -fx-font-weight:bold;
          -fx-background-radius:12;
          -fx-padding:10 18;
        "/>


            <Button text="🖨  Reprint"
                    onAction="#reprint"
                    style="
                      -fx-background-color:#37474f;
                      -fx-text-fill:white;
                      -fx-font-size:13;
                      -fx-background-radius:10;
                      -fx-padding:9 14;
                    "/>

            <Button text="🧾  History"
                    onAction="#history"
                    style="
          -fx-background-color:#37474f;
          -fx-text-fill:white;
          -fx-font-size:13;
          -fx-font-weight:bold;
          -fx-background-radius:12;
          -fx-padding:10 16;
        "/>


            <Button text="📦  Item Master"
                    onAction="#itemMaster"
                    style="
                      -fx-background-color:#37474f;
                      -fx-text-fill:white;
                      -fx-font-size:13;
                      -fx-background-radius:10;
                      -fx-padding:9 14;
                    "/>

            <Button text="👤  Customer Master"
                    onAction="#customerMaster"
                    style="
                      -fx-background-color:#37474f;
                      -fx-text-fill:white;
                      -fx-font-size:13;
                      -fx-background-radius:10;
                      -fx-padding:9 14;
                    "/>
        </FlowPane>
    </VBox>

    <!-- ================= ANALYTICS ================= -->
    <VBox fx:id="analyticsCard"
          spacing="14"
          style="
            -fx-background-color:white;
            -fx-padding:18;
            -fx-background-radius:14;
            -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.07), 14, 0.25, 0, 4);
          ">

        <Label text="Analytics"
               style="-fx-font-size:16; -fx-font-weight:bold;"/>

        <FlowPane hgap="14" vgap="14">
            <Button text="📊  Sales Overview"
                    style="
              -fx-background-color:#f5f5f5;
              -fx-text-fill:#263238;
              -fx-font-weight:bold;
              -fx-background-radius:10;
              -fx-padding:10 16;
            "/>

            <Button text="📅  Monthly Summary"
                    style="
              -fx-background-color:#f5f5f5;
              -fx-text-fill:#263238;
              -fx-font-weight:bold;
              -fx-background-radius:10;
              -fx-padding:10 16;
            "/>

            <Button text="🧾  GST Report"
                    style="
              -fx-background-color:#f5f5f5;
              -fx-text-fill:#263238;
              -fx-font-weight:bold;
              -fx-background-radius:10;
              -fx-padding:10 16;
            "/>
        </FlowPane>

    </VBox>

    <!-- ================= PERSONAL TOOLS ================= -->
    <VBox fx:id="personalToolsCard"
          spacing="14"
          style="
            -fx-background-color:#fafafa;
            -fx-padding:18;
            -fx-background-radius:14;
            -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0.25, 0, 3);
          ">

        <Label text="Personal Tools"
               style="-fx-font-size:16; -fx-font-weight:bold;"/>

        <FlowPane hgap="14" vgap="14">
            <Button text="📊  Sales Overview"
                    style="
              -fx-background-color:#f5f5f5;
              -fx-text-fill:#263238;
              -fx-font-weight:bold;
              -fx-background-radius:10;
              -fx-padding:10 16;
            "/>

            <Button text="📅  Monthly Summary"
                    style="
              -fx-background-color:#f5f5f5;
              -fx-text-fill:#263238;
              -fx-font-weight:bold;
              -fx-background-radius:10;
              -fx-padding:10 16;
            "/>

            <Button text="🧾  GST Report"
                    style="
              -fx-background-color:#f5f5f5;
              -fx-text-fill:#263238;
              -fx-font-weight:bold;
              -fx-background-radius:10;
              -fx-padding:10 16;
            "/>
        </FlowPane>


    </VBox>

</VBox>
