<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root"
      spacing="28"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.HomeController"
      style="-fx-padding:30;">

    <!-- ================= SYSTEM STATUS ================= -->
    <VBox fx:id="systemStatusCard"
          spacing="16"
          style="
            -fx-background-color:white;
            -fx-padding:22;
            -fx-background-radius:16;
            -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0.3, 0, 4);
          ">

        <Label text="System Status"
               style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#263238;"/>

        <HBox spacing="30">
            <VBox spacing="4">
                <Label text="Auto Backup" style="-fx-font-size:12; -fx-text-fill:#607d8b;"/>
                <Label fx:id="backupStatusLabel" style="-fx-font-size:14; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Database Size" style="-fx-font-size:12; -fx-text-fill:#607d8b;"/>
                <Label fx:id="dbSizeLabel" style="-fx-font-size:14; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Invoices" style="-fx-font-size:12; -fx-text-fill:#607d8b;"/>
                <Label fx:id="invoiceCountLabel" style="-fx-font-size:14; -fx-font-weight:bold;"/>
            </VBox>
        </HBox>
    </VBox>


    <!-- ================= CORE OPERATIONS ================= -->
    <VBox fx:id="coreOpsCard"
          spacing="16"
          style="
            -fx-background-color:white;
            -fx-padding:22;
            -fx-background-radius:16;
            -fx-effect:dropshadow(gaussian, rgba(21,101,192,0.18), 18, 0.3, 0, 6);
          ">

        <Label text="Core Operations"
               style="-fx-font-size:18; -fx-font-weight:bold;"/>

        <FlowPane hgap="16" vgap="16">

            <Button text="+  New Invoice" onAction="#newInvoice"
                    style="-fx-background-color:#1565c0; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12; -fx-padding:12 22;"/>

            <Button text="+  Add Contract" onAction="#addContract"
                    style="-fx-background-color:#1565c0; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12; -fx-padding:12 22;"/>

            <Button text="+  Add Purchase Order" onAction="#addPurchaseOrder"
                    style="-fx-background-color:#1565c0; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12; -fx-padding:12 22;"/>
        </FlowPane>
    </VBox>


    <!-- ================= MANAGEMENT ================= -->
    <VBox fx:id="managementCard"
          spacing="16"
          style="
            -fx-background-color:white;
            -fx-padding:22;
            -fx-background-radius:16;
            -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.07), 14, 0.25, 0, 4);
          ">

        <Label text="Management"
               style="-fx-font-size:18; -fx-font-weight:bold;"/>

        <FlowPane hgap="16" vgap="16">

            <Button text="Invoices" onAction="#history"
                    style="-fx-background-color:#37474f; -fx-text-fill:white; -fx-background-radius:10; -fx-padding:10 18;"/>

            <Button text="Contracts" onAction="#viewContracts"
                    style="-fx-background-color:#37474f; -fx-text-fill:white; -fx-background-radius:10; -fx-padding:10 18;"/>

            <Button text="Purchase Orders" onAction="#viewPurchaseOrders"
                    style="-fx-background-color:#37474f; -fx-text-fill:white; -fx-background-radius:10; -fx-padding:10 18;"/>

            <Button text="Items" onAction="#itemMaster"
                    style="-fx-background-color:#37474f; -fx-text-fill:white; -fx-background-radius:10; -fx-padding:10 18;"/>

            <Button text="Customers" onAction="#customerMaster"
                    style="-fx-background-color:#37474f; -fx-text-fill:white; -fx-background-radius:10; -fx-padding:10 18;"/>

        </FlowPane>
    </VBox>


    <!-- ================= ANALYTICS ================= -->
    <VBox fx:id="analyticsCard"
          spacing="16"
          style="
            -fx-background-color:white;
            -fx-padding:20;
            -fx-background-radius:14;
            -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.07), 14, 0.25, 0, 4);
          ">

        <Label text="Analytics"
               style="-fx-font-size:17; -fx-font-weight:bold;"/>

        <FlowPane hgap="14" vgap="14">
            <Button text="Sales Overview"/>
            <Button text="Monthly Summary"/>
            <Button text="GST Report"/>
        </FlowPane>
    </VBox>


</VBox>