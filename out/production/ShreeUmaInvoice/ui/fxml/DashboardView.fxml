<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.effect.DropShadow?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1200"
            prefHeight="720"
            style="-fx-background-color:#eceff1;">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox spacing="18"
              prefWidth="240"
              style="-fx-background-color:#263238;">

            <padding>
                <Insets top="25" right="20" bottom="40" left="20"/>
            </padding>

            <VBox alignment="CENTER"
                  style="
        -fx-background-color:#0b1220;
        -fx-padding:22;
        -fx-background-radius:18;
      ">

                <StackPane alignment="CENTER">

                    <ImageView fx:id="logoImage"
                               fitWidth="140"
                               fitHeight="140"
                               preserveRatio="true"
                               smooth="true"
                               cache="true"
                               cacheHint="SPEED">
                        <image>
                            <Image url="@/resources/ui/assets/sua_logo.png"/>
                        </image>
                    </ImageView>

                </StackPane>

            </VBox>






            <Separator/>

            <Label text="Dashboard"
                   style="-fx-text-fill:#b0bec5; -fx-font-size:14; -fx-font-weight:bold;"/>

            <Button text="🏠  Home"
                    style="
            -fx-background-color:transparent;
            -fx-text-fill:white;
            -fx-font-size:13;
            -fx-alignment:CENTER_LEFT;
        "/>

            <Separator/>

            <!-- ================= PERSONAL LABS ================= -->

            <HBox fx:id="personalHoverZone"
                  alignment="CENTER_LEFT"
                  spacing="6">
                <Button fx:id="personalBtn"
                        text="🧪  Personal Labs"
                        style="-fx-background-color:transparent; -fx-text-fill:white; -fx-font-size:13; -fx-alignment:CENTER_LEFT;"/>

                <Label fx:id="personalArrow"
                       text="▶"
                       style="-fx-text-fill:white; -fx-font-size:11;"/>
            </HBox>

            <!-- PUSH EVERYTHING BELOW TO BOTTOM -->
            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>

            <Label text="Maintenance"
                   style="-fx-text-fill:#90a4ae; -fx-font-size:12; -fx-font-weight:bold;"/>

            <Button
                    text="💾  Backup Database"
                    onAction="#backupNow"
                    onMouseEntered="#secondaryHoverIn"
                    onMouseExited="#restoreBaseStyle"

                    minWidth="200"
                    prefWidth="200"
                    maxWidth="200"

                    minHeight="38"
                    prefHeight="38"
                    maxHeight="38"

                    userData="
        -fx-background-color:#37474f;
        -fx-text-fill:white;
        -fx-font-size:13;
        -fx-font-weight:bold;
        -fx-background-radius:10;
        -fx-padding:10 14;
    "
                    style="
        -fx-background-color:#37474f;
        -fx-text-fill:white;
        -fx-font-size:13;
        -fx-font-weight:bold;
        -fx-background-radius:10;
        -fx-padding:10 14;
    "/>



            <Button
                    text="⚠️  Restore Database"
                    onAction="#openRestoreDatabase"
                    onMouseEntered="#dangerHoverIn"
                    onMouseExited="#restoreBaseStyle"

                    minWidth="200"
                    prefWidth="200"
                    maxWidth="200"

                    minHeight="38"
                    prefHeight="38"
                    maxHeight="38"

                    userData="
        -fx-background-color:#c62828;
        -fx-text-fill:white;
        -fx-font-size:13;
        -fx-font-weight:bold;
        -fx-background-radius:10;
        -fx-padding:10 14;
    "
                    style="
        -fx-background-color:#c62828;
        -fx-text-fill:white;
        -fx-font-size:13;
        -fx-font-weight:bold;
        -fx-background-radius:10;
        -fx-padding:10 14;
    "/>




            <Label fx:id="autoBackupStatusLabel"
                    text="Checking auto backup..."
                    wrapText="true"
                    style="
           -fx-text-fill:#b0bec5;
           -fx-font-size:11;
           -fx-font-weight:500;
       "/>


            <Separator/>

            <Label text="Powered by Shree Uma Associates"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="
           -fx-font-size:9;
           -fx-text-fill:#90a4ae;
           -fx-opacity:0.75;
           -fx-padding:14 0 0 0;
       ">
                <effect>
                    <DropShadow
                            radius="6"
                            spread="0.05"
                            offsetX="0"
                            offsetY="0"
                            color="rgba(144,164,174,0.35)"/>
                </effect>
            </Label>

        </VBox>


    </left>


    <!-- ===== MAIN PANEL ===== -->
    <center>
        <StackPane fx:id="mainLayer">
            <VBox>
                <!-- ===== APP TITLE BAR ===== -->
                <BorderPane
                        minHeight="64"
                        prefHeight="64"
                        style="
            -fx-padding:14 24;
            -fx-background-color:#f8fafc;
            -fx-border-color:#e0e6eb;
            -fx-border-width:0 0 1 0;
        ">

                    <!-- CENTER TITLE -->
                    <center>
                        <HBox alignment="CENTER" spacing="8">
                            <Label fx:id="companyNameLabel"
                                    text="Shree Uma Associates"
                                   style="
                       -fx-font-size:21;
                       -fx-font-weight:800;
                       -fx-text-fill:#1f2933;
                   "/>

                            <Label text="– Invoice Management"
                                   style="
                       -fx-font-size:14;
                       -fx-text-fill:#6b7280;
                   "/>
                        </HBox>
                    </center>

                    <!-- USER / ROLE -->
                    <right>
                        <HBox spacing="8"
                              alignment="CENTER"
                              style="
                  -fx-padding:6 14;
                  -fx-background-color:#eef2f7;
                  -fx-background-radius:999;
                  -fx-border-color:#d0d7de;
                  -fx-border-radius:999;
              ">

                            <Label fx:id="userRoleLabel"
                                    text="IT Officer"
                                   style="
                       -fx-font-size:11;
                       -fx-text-fill:#475569;
                   "/>

                            <Label text="•" style="-fx-text-fill:#94a3b8;"/>

                            <Label fx:id="usernameLabel"
                                    text="Harshit"
                                   style="
                       -fx-font-size:13;
                       -fx-font-weight:bold;
                       -fx-text-fill:#1d4ed8;
                   "/>
                        </HBox>
                    </right>

                </BorderPane>






                <!-- ===== TOP NAV BAR ===== -->
                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      style="
                -fx-padding:12 16;
                -fx-background-color:#ffffff;
                -fx-border-color:#cfd8dc;
                -fx-border-width:0 0 1 0;
                -fx-background-radius:14;
              ">

                    <!-- BACK BUTTON -->
                    <Button fx:id="backButton"
                            text="← Back"
                            onAction="#goBack"
                            onMouseEntered="#backHoverIn"
                            onMouseExited="#restoreBaseStyle"
                            disable="true"

                            minWidth="84"
                            prefWidth="84"
                            maxWidth="84"

                            minHeight="32"
                            prefHeight="32"
                            maxHeight="32"

                            userData="
            -fx-background-color:#f1f5f9;
            -fx-text-fill:#1565c0;
            -fx-font-size:13;
            -fx-font-weight:bold;
            -fx-background-radius:8;
            -fx-padding:6 12;
        "
                            style="
            -fx-background-color:#f1f5f9;
            -fx-text-fill:#1565c0;
            -fx-font-size:13;
            -fx-font-weight:bold;
            -fx-background-radius:8;
            -fx-padding:6 12;
        "/>


                    <!-- BREADCRUMBS -->
                    <HBox fx:id="breadcrumbBar"
                          spacing="6"
                          alignment="CENTER_LEFT"
                          style="
        -fx-padding:8 12;
        -fx-background-color:#f4f6f8;
        -fx-border-color:#dcdcdc;
        -fx-border-width:0 0 1 0;
      "/>
                </HBox>

                <!-- ===== CONTENT AREA ===== -->
                <StackPane fx:id="contentPane">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30"/>
                    </padding>

                    <!-- DEFAULT LANDING CONTENT (HOME) -->
                </StackPane>
            </VBox>

            <VBox fx:id="personalFlyout"
                  visible="false"
                  managed="false"
                  spacing="8"
                  minWidth="180"
                  maxWidth="260"
                  style="
    -fx-background-color: rgba(30,42,50,0.92);
    -fx-padding:16;
    -fx-background-radius:16;
    -fx-border-radius:16;
    -fx-border-color: rgba(255,255,255,0.06);
    -fx-border-width:1;
"
                  StackPane.alignment="TOP_LEFT">

                <Button text="🤖  AI Assistant"
                        minHeight="34"
                        style="
    -fx-background-color:#2a3942;
    -fx-text-fill:white;
    -fx-background-radius:10;
    -fx-alignment:CENTER_LEFT;
    -fx-padding:8 12;
    -fx-font-size:12;
    -fx-cursor:hand;
"/>
                <Button text="📊  Smart Insights"
                        minHeight="34"
                        style="
    -fx-background-color:#2a3942;
    -fx-text-fill:white;
    -fx-background-radius:10;
    -fx-alignment:CENTER_LEFT;
    -fx-padding:8 12;
    -fx-font-size:12;
    -fx-cursor:hand;
"/>
                <Button text="🧠  Contract Predictor"
                        minHeight="34"
                        style="
    -fx-background-color:#2a3942;
    -fx-text-fill:white;
    -fx-background-radius:10;
    -fx-alignment:CENTER_LEFT;
    -fx-padding:8 12;
    -fx-font-size:12;
    -fx-cursor:hand;
"/>
                <Button text="📝  Auto Draft Generator"
                        minHeight="34"
                        style="
    -fx-background-color:#2a3942;
    -fx-text-fill:white;
    -fx-background-radius:10;
    -fx-alignment:CENTER_LEFT;
    -fx-padding:8 12;
    -fx-font-size:12;
    -fx-cursor:hand;
"/>


            </VBox>

            <!-- 🔒 RESTORE LOCK OVERLAY -->
            <VBox fx:id="restoreOverlay"
                  visible="false"
                  managed="false"
                  alignment="CENTER"
                  style="
                -fx-background-color: rgba(0,0,0,0.35);
              ">

                <VBox spacing="12"
                      alignment="CENTER"
                      style="
                    -fx-background-color:white;
                    -fx-padding:24;
                    -fx-background-radius:12;
                  ">

                    <Label text="Restoring Database"
                           style="-fx-font-size:16; -fx-font-weight:bold;"/>

                    <Label text="Please do not close the application."
                           style="-fx-font-size:13; -fx-text-fill:#555;"/>
                </VBox>

            </VBox>

        </StackPane>
    </center>





</BorderPane>
